    "db:seed:diagnostic": "node packages/db/seed-diagnostic.js",
    "eval": "tsx eval/run-eval.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.15.0"
  },
  "dependencies": {
    "pg": "^8.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5"
  }
}
