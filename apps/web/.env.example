# Copy this file to apps/web/.env.local and fill in every value.
# Plain KEY=value lines — no quotes, no spaces around the "=".
# .env.local is never committed or shipped in the zip (it holds secrets).

# --- Supabase: Project Settings > API ---
# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same Project URL as above — the standalone scripts (db:seed, db:seed:diagnostic,
# eval) read this one, because they run outside Next.js.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Server-only — never expose to the browser. Used for every write RLS blocks the
# client from making directly (mastery, question_attempts, misconceptions, events).
SUPABASE_SERVICE_ROLE_KEY=

# --- Database connection (used only by `npm run db:migrate`) ---
# Supabase dashboard > Connect (top of the page) > copy the connection string,
# then paste it here as ONE line.
#
#  * Prefer the "Session pooler" string. The "Direct connection" string is
#    IPv6-only on newer projects, and many home networks are IPv4-only, which
#    shows up as ENOTFOUND / ETIMEDOUT.
#  * Replace the [YOUR-PASSWORD] placeholder INCLUDING the square brackets.
#  * Use a database password of letters and numbers only. Characters like
#    @ # / ? : % break the URL unless percent-encoded. If in doubt: Project
#    Settings > Database > Reset database password, and pick a simple one.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- AI provider (Gemini for the MVP; see packages/core/ai-provider) ---
# Get one at https://aistudio.google.com/apikey — keep it out of chats and repos.
GEMINI_API_KEY=

# --- Optional ---
# Only needed if a separately-hosted frontend (e.g. a standalone Bolt app) calls this
# API cross-origin. See docs/bolt-integration.md. Leave unset to keep /api/* closed.
BOLT_FRONTEND_ORIGIN=
